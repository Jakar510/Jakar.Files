<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<!-- Types stay in the Jakar.Extensions namespace, as every package split out of Jakar.Extensions does (MigrationPlan.md). -->
		<RootNamespace>Jakar.Extensions</RootNamespace>
		<AssemblyName>Jakar.Files</AssemblyName>
		<Version>10.2.0</Version>
		<Title>Jakar.Files</Title>
		<PackageId>Jakar.Files</PackageId>
		<Authors>Tyler Stegmaier</Authors>
		<Description>Files, directories, file watchers, embedded resources, INI configuration and preference files for Jakar.Extensions.</Description>
		<PackageTags>Files Directories FileWatcher Ini Preferences EmbeddedResources</PackageTags>
		<PackageReleaseNotes>10.2.0: BREAKING: no longer depends on Jakar.Extensions (Jakar.Core, Jakar.Logging, Jakar.Collections instead). Gains MimeType/MimeTypes/MimeTypeNames and EncodingConverter. DataProtectorFiles, AppSettings and LanguageApi moved to Jakar.Extensions 10.13.0. 10.1.0: initial release. Split out of Jakar.Extensions 10.12.0; the types keep the Jakar.Extensions namespace.</PackageReleaseNotes>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Jakar510/Jakar.Files</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Jakar510/Jakar.Files</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591;IDE0079;CS8424;IDE0046;CS1658</NoWarn>
		<WarningsAsErrors>Nullable;CS0114;CS9113;IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL2111;IL3050;IL3051</WarningsAsErrors>
		<IsAotCompatible>true</IsAotCompatible>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!-- Jakar.Json's attributes are [Conditional]: keep them in this assembly's metadata, so [JsonModel] types in other assemblies see them on the members they inherit. -->
		<DefineConstants>$(DefineConstants);JAKAR_JSON_KEEP_ATTRIBUTES</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Jakar.Collections" />
		<PackageReference Include="Jakar.Core" />
		<PackageReference Include="Jakar.Logging" />
		<PackageReference Include="CommunityToolkit.Diagnostics" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
		<PackageReference Include="OneOf" />
		<PackageReference Include="ZLinq" />
		<PackageReference Include="JetBrains.Annotations" />
		<PackageReference Include="ZLinq.FileSystem" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Jakar.Files.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>